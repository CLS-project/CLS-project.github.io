---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import aboutImg from '../assets/photos/about.jpg'
import ccpImg from '../assets/aws-ccp.png'
import danielImg from '../assets/photos/Daniel-de-Andres.jpg'
import atulitImg from '../assets/photos/AtulitSrivastava.jpg'
import patrickImg from '../assets/photos/PatrickJanulewicz.jpeg'
import weiguangImg from '../assets/photos/Weiguang.jpg'

const signature = `Thank you for your time.
© ${new Date().getFullYear()} - CLS project`
---

<Layout title="Members">
    <div class='max-w-screen-md mx-auto pb-6 px-5 print:my-0 print:h-screen print:bg-white print:text-black print:py-0'
    >
        <div class='flex flex-col md:flex-row print:flex-row gap-4 items-center'>
            <div class='min-w-[6rem] max-w-[6rem]'>
                <Image
                src={weiguangImg}
                alt='Weiguang Cui'
                class='object-cover rounded-full'
                />
            </div>
            <div class='flex flex-col justify-center w-full'>
                <div class='flex flex-row justify-between'>
                    <div>
                        <h1 class='text-xl'>Weiguang Cui  </h1>
                        <h2 class='text-sm'>Full-time Developer  </h2>
                    </div>
                    <div class='flex flex-col gap-1 justify-center items-end'>
                        <a href='https://weiguangcui.github.io/' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:globe' class='inline-block w-3 h-3' />
                            https://weiguangcui.github.io </a>
                        <a href='mailto:weiguang.cui@uam.es' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:at' class='inline-block w-3 h-3' />
                            weiguang.cui@uam.es </a>
                    </div>
                </div>
            </div>
        </div>

        <div class='flex flex-col md:flex-row print:flex-row gap-4 items-center'>
            <div class='min-w-[6rem] max-w-[6rem]'>
                <Image
                src={danielImg}
                alt='Daniel de Andres'
                class='object-cover rounded-full'
                />
            </div>
            <div class='flex flex-col justify-center w-full'>
                <div class='flex flex-row justify-between'>
                    <div>
                        <h1 class='text-xl'>Daniel de Andres </h1>
                        <h2 class='text-sm'>PostDoc researcher  </h2>
                    </div>
                    <div class='flex flex-col gap-1 justify-center items-end'>
                        <a href='https://www.uam.es/FisicaTeorica/de-Andr%C3%A9s-Hern%C3%A1ndez,-Daniel/1446796645151.htm?language=es&pid=1446793621678&title=de%20Andr%C3%A9s%20Hern%C3%A1ndez%20Daniel' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:globe' class='inline-block w-3 h-3' />
                            Personal website </a>
                        <a href='mailto:daniel.deandres@uam.es' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:at' class='inline-block w-3 h-3' />
                            daniel.deandres@uam.es </a>
                    </div>
                </div>
            </div>
        </div>

        <div class='flex flex-col md:flex-row print:flex-row gap-4 items-center'>
            <div class='min-w-[6rem] max-w-[6rem]'>
                <Image
                src={atulitImg}
                alt='Atulit Srivastava'
                class='object-cover rounded-full'
                />
            </div>
            <div class='flex flex-col justify-center w-full'>
                <div class='flex flex-row justify-between'>
                    <div>
                        <h1 class='text-xl'>Atulit Srivastava  </h1>
                        <h2 class='text-sm'>PdD Student </h2>
                    </div>
                    <div class='flex flex-col gap-1 justify-center items-end'>
                        <a href='https://www.uam.es/ss/Satellite?c=EPS_Persona_FA&cid=1446846519116&language=es&pagename=DptoFisica%2FEPS_Persona_FA%2FFAC_detallePDI&pid=1446793621678&title=Srivastava+Atulit' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:globe' class='inline-block w-3 h-3' />
                            Personal website </a>
                        <a href='mailto:atulit.srivastava@uam.es' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:at' class='inline-block w-3 h-3' />
                            atulit.srivastava@uam.es </a>
                    </div>
                </div>
            </div>
        </div>

        <div class='flex flex-col md:flex-row print:flex-row gap-4 items-center'>
            <div class='min-w-[6rem] max-w-[6rem]'>
                <Image
                src={patrickImg}
                alt='Patrick Janulewicz'
                class='object-cover rounded-full'
                />
            </div>
            <div class='flex flex-col justify-center w-full'>
                <div class='flex flex-row justify-between'>
                    <div>
                        <h1 class='text-xl'>Patrick Janulewicz  </h1>
                        <h2 class='text-sm'>External collaborator </h2>
                    </div>
                    <div class='flex flex-col gap-1 justify-center items-end'>
                        <a href='https://orcid.org/0009-0004-9465-428X' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:globe' class='inline-block w-3 h-3' />
                            Personal website </a>
                        <a href='mailto:patrick.janulewicz@mail.mcgill.ca' target='_blank' class='text-xs hover:underline focus:underline'
                        ><Icon name='fa6-solid:at' class='inline-block w-3 h-3' />
                            patrick.janulewicz@mail.mcgill.ca </a>
                    </div>
                </div>
            </div>
        </div>

        </div>
    </div>
</Layout>

