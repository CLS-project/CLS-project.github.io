---
import Layout from '../layouts/Layout.astro'

const res = await fetch('https://api.github.com/orgs/CLS-project/repos?per_page=100', {
  headers: { 'User-Agent': 'CLS-website' }
})
if (!res.ok) {
  throw new Error(`GitHub API error: ${res.status}`)
}
type Repo = {
  name: string
  full_name: string
  html_url: string
  description: string | null
  stargazers_count: number
  forks_count: number
  language: string | null
  updated_at: string
  archived: boolean
}

const repos = (await res.json()) as Repo[]

const visibleRepos: Repo[] = repos
  .filter((r: Repo) => !r.archived)
  .sort((a: Repo, b: Repo) => b.stargazers_count - a.stargazers_count)
---

<Layout title="Repositories of CLS">
  <section class="space-y-6 w-full mx-auto px-10 md:px-24 my-40 max-w-screen-xl">
    <p>
      All CLS repositories are at
      <a href="https://github.com/CLS-project" target="_blank" class="underline">https://github.com/CLS-project</a>.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-2 gap-6">
      {visibleRepos.map((repo: Repo) => (
        <a
          href={repo.html_url}
          target="_blank"
          rel="noreferrer"
          class="block rounded-lg border border-white/10 bg-neutral-900 hover:bg-neutral-800 transition p-4 h-full"
        >
          <h3 class="text-lg font-semibold break-words">{repo.name}</h3>
          {repo.description && (
            <p class="mt-2 text-sm text-neutral-400">
              {repo.description}
            </p>
          )}
          <div class="mt-3 text-xs text-neutral-400 flex flex-wrap gap-4">
            <span>⭐ {repo.stargazers_count}</span>
            <span>🍴 {repo.forks_count}</span>
            {repo.language && <span>💻 {repo.language}</span>}
            <span>🕒 {new Date(repo.updated_at).toLocaleDateString()}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>